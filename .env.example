# Copy to .env for local dev. NEVER commit a real .env, and never put a
# real secret in this file. Placeholders only.
# On Railway, set these as service variables instead.

# --- Server ---
# Name shown to MCP clients (tools/list, health, landing page).
MCP_SERVER_NAME=mcp-starter
# Version reported to MCP clients.
MCP_SERVER_VERSION=0.1.0
# Port for local dev only. Railway injects $PORT at runtime.
PORT=8000

# --- Storage (SQLite) ---
# Path of the SQLite file. Relative to the working directory.
# Without a Railway Volume mounted at data/, this file is ephemeral
# and notes are lost on redeploy.
DATABASE_PATH=data/notes.db

# --- Auth (optional, but set it before exposing publicly) ---
# When set, /mcp requires: Authorization: Bearer <MCP_AUTH_TOKEN>
# When empty (default), /mcp is OPEN and /api/health reports
# auth: "disabled". / and /api/health stay public either way.
MCP_AUTH_TOKEN=

# --- MCP transport security (DNS rebinding protection, ON) ---
# The SDK rejects requests whose Host/Origin is not on these lists.
# Defaults below are localhost-only (local dev). ON RAILWAY you MUST
# set these to your EXACT public domain, e.g.:
#   MCP_ALLOWED_HOSTS=myapp.up.railway.app
#   MCP_ALLOWED_ORIGINS=https://myapp.up.railway.app
# Otherwise the public host is rejected (HTTP 421). Wildcards only
# cover ports ("host:*") — "*.up.railway.app" does NOT work, because
# the SDK does not support subdomain wildcards. Comma-separated.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
